# =====================================================================
# Douyin Downloader — environment configuration
#
# Copy this file to `.env` (repo root or backend/) and fill in your values.
# The backend auto-loads `.env` via a zero-dependency loader in
# backend/config/douyin.config.js — no extra packages required.
# =====================================================================

# --- Authentication (recommended) ------------------------------------
# Browser cookies from a logged-in Douyin session. Used to bypass anti-bot
# protection and access member-only content.
#
#   Format 1 (header string): "name=value; name2=value2"
#   Format 2 (JSON array):    '[{"name":"sessionid","value":"..."}]'
#
# Minimum required: sessionid. Recommended: ttwid, msToken.
# How to obtain: log in at https://www.douyin.com/, open DevTools -> Application
# -> Cookies, and copy the values of the relevant cookies.
DOUYIN_COOKIES=sessionid=xxx;ttwid=xxx;msToken=xxx

# --- Proxy (optional) ------------------------------------------------
# Route all Douyin requests through a proxy.
HTTP_PROXY=http://user:pass@host:port
HTTPS_PROXY=http://user:pass@host:port

# --- Behaviour --------------------------------------------------------
# When "1", the app fails fast at startup if DOUYIN_COOKIES is missing,
# malformed or lacks `sessionid` (non-mock mode). Default "0" lets anonymous
# requests proceed with a warning.
DOUYIN_REQUIRE_COOKIE=0

# Offline demo/testing mode: "1" never touches the network.
DOUYIN_MOCK=0

# --- Tuning (optional, shown with defaults) --------------------------
# DOUYIN_USER_AGENT=                    # custom User-Agent (defaults to modern Chrome)
# DOUYIN_TIMEOUT_MS=20000               # per-request timeout (ms)
# DOUYIN_DOWNLOAD_TIMEOUT_MS=600000     # video stream download timeout (ms)
# DOUYIN_MAX_RETRIES=3                  # retries for transient failures
# DOUYIN_RETRY_DELAY_MS=1000            # base backoff delay between retries (ms)
# DOUYIN_RATE_LIMIT_MS=0                # min spacing between requests (ms, 0 = off)
